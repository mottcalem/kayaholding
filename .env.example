# Gmail / Google Workspace SMTP
# https://support.google.com/a/answer/176600
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 465 kullanıyorsanız: SMTP_PORT=465 ve SMTP_SECURE=true
SMTP_SECURE=false
# Gönderen hesap (Workspace)
SMTP_USER=
# Google Hesap → Güvenlik → 2 Adımlı Doğrulama → Uygulama şifreleri (16 karakter)
SMTP_PASS=
# Boş bırakılırsa SMTP_USER kullanılır
SMTP_FROM=
# Form bildirimlerinin gideceği adres(ler); virgülle ayırabilirsiniz
SMTP_TO=ik@kayaholding.com.tr

# Yerel: bu dosyayı .env.local olarak kopyalayıp değerleri doldurun (.env.local git’e eklenmez).
# Canlı: Windows sunucuda aynı SMTP_* değişkenlerini ortam değişkeni / .env olarak tanımlayın.
